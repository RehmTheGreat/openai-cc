{
  "name": "openai-cc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loopback Anthropic-compatible gateway for Claude Code and Claude Desktop with routed upstream credentials.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node dist/scripts/write-build-info.js",
    "test": "npm run build && node dist/scripts/run-tests.js",
    "start": "node dist/src/index.js",
    "desktop:configure": "tsx scripts/configure-claude-desktop.ts",
    "codex:doctor": "tsx scripts/codex-doctor.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openai/codex": "0.146.0",
    "@openai-oauth/core": "2.0.0",
    "@openai-oauth/local": "2.0.0",
    "openai": "6.48.0"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  }
}
